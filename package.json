{
  "name": "polaris-ui",
  "version": "0.3.0",
  "description": "Polaris design-system foundation: shared tokens, primitives, data, and per-app components used by all 4 Polaris web apps (Edge, DEFI, Tokenization, ETF Advisor).",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./edge": "./src/edge/index.ts",
    "./defi": "./src/defi/index.ts",
    "./tokenization": "./src/tokenization/index.ts",
    "./advisor": "./src/advisor/index.ts"
  },
  "files": [
    "src/**/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3"
  }
}