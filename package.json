{
  "name": "vylos-ui",
  "version": "0.8.0",
  "description": "VYLOS design-system foundation: shared tokens, primitives, data, mobile shell, and per-app components used by all 4 VYLOS web apps (Signal, Yield, Ground, Advisor).",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./advisor": "./src/advisor/index.ts"
  },
  "files": [
    "src/**/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3"
  }
}
